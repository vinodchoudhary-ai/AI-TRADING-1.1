# Copy to .env.local (never commit it). Everything is optional for local development.

# Real gold prices (twelvedata.com). Without it, gold shows clearly labelled sample data and the analysis is off.
TWELVEDATA_API_KEY=
# Upstream gold calls allowed per UTC day (the free plan allows about 800).
GOLD_DAILY_BUDGET=700

# Public address of the site, no trailing slash. REQUIRED in production for emails, robots.txt and the sitemap.
APP_URL=
# Email (verification and password reset). Without SMTP_URL + MAIL_FROM: dev writes data/outbox.log, production disables email.
SMTP_URL=
MAIL_FROM=

# Where the SQLite database lives (default ./data/aurum.db). Point it at persistent storage in production.
DATABASE_FILE=
# Minutes between signal-tracker passes (default 10).
JOB_INTERVAL_MIN=10
